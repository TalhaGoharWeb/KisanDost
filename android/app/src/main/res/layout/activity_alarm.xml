<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/alarm_background"
    android:keepScreenOn="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- Top Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="کسان دوست الارم"
                android:textColor="#B3FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="اہم زرعی سرگرمی کا وقت ہو گیا ہے!"
                android:textColor="#FFEB3B"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Alarm Icon Frame -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="30dp"
                android:background="@drawable/alarm_circle_background">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_lock_idle_alarm"
                    android:tint="@android:color/white"
                    tools:ignore="UseAppTint" />
            </FrameLayout>

            <!-- Card View details container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/alarm_card_background"
                android:padding="24dp"
                android:elevation="8dp"
                android:layout_marginBottom="30dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@android:drawable/ic_dialog_info"
                    android:tint="#4CAF50"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/task_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="لوڈ ہو رہا ہے..."
                    android:textColor="#E0000000"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/task_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="تفصیل"
                    android:textColor="#616161"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#E0E0E0" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_today"
                        android:tint="#616161"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:id="@+id/task_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="#424242"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:text="12-07-2026 10:00 AM" />
                </LinearLayout>

                <TextView
                    android:id="@+id/task_recurrence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:textColor="#512DA8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="دوبارہ یاد دہانی: بغیر دہرائے" />
            </LinearLayout>

            <!-- Complete Task Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_complete"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="کام مکمل ہو گیا"
                android:textSize="20sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="#4CAF50"
                app:cornerRadius="20dp"
                android:elevation="4dp"
                android:layout_marginBottom="12dp"/>

            <!-- Dismiss Alarm Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dismiss"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="الارم بند کریں (ڈسمس)"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="#455A64"
                app:cornerRadius="20dp"
                android:elevation="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- Snooze Options -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سوز کے اختیارات:"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_snooze_5"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="۵ منٹ"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:strokeColor="#80FFFFFF"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="#26FFFFFF"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_snooze_10"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginStart="6dp"
                    android:text="۱۰ منٹ"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:strokeColor="#80FFFFFF"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="#26FFFFFF"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_snooze_15"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="۱۵ منٹ"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:strokeColor="#80FFFFFF"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="#26FFFFFF"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
